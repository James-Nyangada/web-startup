# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Front-end origins allowed to call the API (CORS).
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CORS_ORIGINS=

# Supabase → Connect → Connection string → "Session pooler" (port 5432).
# Replace [YOUR-PASSWORD] with your database password. URL-encode special characters
# in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional: path to Supabase's CA certificate (Project Settings → Database → SSL) to
# verify the server certificate. Without it the connection is encrypted but unverified.
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10
# Worker's pg-boss pool (default 10; the API's send-only pool is fixed at 2). Behind a session pooler, keep the total of both pools across API + worker under its limit.
PG_BOSS_POOL_MAX=

# Optional in development. Required in production.
TURNSTILE_SECRET_KEY=
# Resend. Unset in development: emails (with their links) are printed to the log instead.
RESEND_API_KEY=
EMAIL_FROM=EveryVisitor <no-reply@everyvisitor.app>
EMAIL_REPLY_TO=info@everyvisitor.app
# Logo in the email header. Defaults to $APP_URL/email/everyvisitor-logo.png, which must be publicly reachable.
EMAIL_LOGO_URL=

# AES-256-GCM encryption key for webhook URLs and secrets at rest (32+ bytes, spec 3.0 & 11.1)
ENCRYPTION_KEY=dev_encryption_key_32_characters_long_for_aes_256

# Better Auth secret (32+ bytes, spec 3.1)
AUTH_SECRET=dev_secret_must_be_at_least_32_characters_long_for_auth

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: errors are sent to Sentry when set.
SENTRY_DSN_API=
SENTRY_RELEASE=

# Scanner (Phase 1). Honest bot user agent with a link explaining what we do (spec 11.3).
SCANNER_USER_AGENT=PRODUCT_NAMEBot/1.0 (+https://example.com/bot)
# Worker only. Pages scanned in parallel inside one scan (default 2), and scans run at once (default 1).
# Memory grows with the product of the two: about 200 MB per page being scanned.
SCANNER_CONCURRENCY=
SCAN_RUN_CONCURRENCY=

# AI Fix Suggestions (Phase 3 Chunk P3-07, Section 6.10)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SUGGESTIONS_MONTHLY_CAP=50
FEATURE_AI_SUGGESTIONS=true

# File storage (reports, attachments, exports, logos, avatars): Cloudinary → Settings → API Keys.
# When these three are set they take priority over R2 and STORAGE_DIR. CLOUDINARY_FOLDER prefixes
# every public ID (e.g. "production") so environments sharing an account stay apart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
# Object storage (Cloudflare R2, S3 API). Leave empty to store files in STORAGE_DIR (default ./.storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
STORAGE_DIR=

# Billing with Paddle (Phase 4, Spec Section 3 & 12)
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_01m60d57cv1db9eyk01aen0p79_1eJeJnZ3HRexE199rsE3Zy_Ajl
PADDLE_WEBHOOK_SECRET=pdl_ntfset_01m60efg1a29z3twre80q05ng3_/+m+WXoujIw7LssjEoppZhr3kC47/v5Y
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_88ed1ef73ffb5be18e4dfb07112
PADDLE_PRICE_STORE_MONTHLY=pri_01m60c9stpje4swn0jnse2efce
PADDLE_PRICE_STORE_ANNUAL=pri_01m60cmqf13tk4c757e6fhcxwm
PADDLE_PRICE_GROWTH_MONTHLY=pri_01m60cbe23v4ygq0zxncgvpgh1
PADDLE_PRICE_GROWTH_ANNUAL=pri_01m60cp4bc3xcrvmaj5yev0e9b
PADDLE_PRICE_AGENCY_MONTHLY=pri_01m60cd4nz1833cqn12kgq1a0v
PADDLE_PRICE_AGENCY_ANNUAL=pri_01m60cqhf0ap7xh6f3bbz2pnfe
PADDLE_PRICE_AGENCY_PRO_MONTHLY=pri_01m60ced985q1g9jr96t35gatj
PADDLE_PRICE_AGENCY_PRO_ANNUAL=pri_01m60cs4v29365acpcw83yn3vd

# Phase 6
# Maintenance mode (P6-12): API answers 503 (health checks stay up) and the worker takes no jobs.
MAINTENANCE_MODE=false
# Custom portal domains (P6-07): host agencies point their CNAME at. Defaults to portal.<app host>.
CUSTOM_DOMAIN_TARGET=
# Session cookie domain shared by app.<domain> and api.<domain> in production, e.g. .example.com (spec 11.1).
COOKIE_DOMAIN=
# Volume whose free space the staff system monitor reports (P6-03). Defaults to the working directory.
DATA_DIR=
