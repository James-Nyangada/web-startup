# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Front-end origins allowed to call the API (CORS).
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CORS_ORIGINS=

# Supabase → Connect → Connection string → "Session pooler" (port 5432).
# Replace [YOUR-PASSWORD] with your database password. URL-encode special characters
# in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional: path to Supabase's CA certificate (Project Settings → Database → SSL) to
# verify the server certificate. Without it the connection is encrypted but unverified.
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10

# Optional in development. Required in production.
TURNSTILE_SECRET_KEY=

# Better Auth secret (32+ bytes, spec 3.1)
AUTH_SECRET=dev_secret_must_be_at_least_32_characters_long_for_auth

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: errors are sent to Sentry when set.
SENTRY_DSN_API=
SENTRY_RELEASE=

# Scanner (Phase 1). Honest bot user agent with a link explaining what we do (spec 11.3).
SCANNER_USER_AGENT=PRODUCT_NAMEBot/1.0 (+https://example.com/bot)

# AI Fix Suggestions (Phase 3 Chunk P3-07, Section 6.10)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SUGGESTIONS_MONTHLY_CAP=50
FEATURE_AI_SUGGESTIONS=true
