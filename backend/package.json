{
  "name": "backend",
  "version": "0.1.0",
  "description": "PRODUCT_NAME API (Express 5 + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/index.js",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/scripts/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/scripts/migrate.ts",
    "metrics:backfill": "tsx --env-file-if-exists=.env src/db/scripts/backfill-metrics.ts",
    "content:import": "tsx --env-file-if-exists=.env src/db/scripts/import-content.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/scripts/reset.ts",
    "db:studio": "drizzle-kit studio",
    "scan:discover": "tsx --env-file-if-exists=.env src/scanner/cli/discover.ts",
    "scan": "tsx --env-file-if-exists=.env src/scanner/cli/scan.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "paddle:replay": "tsx --env-file-if-exists=.env src/billing/replay.ts",
    "fixtures:serve": "tsx tests/fixtures/site/serve.ts",
    "load:queue": "tsx --env-file-if-exists=.env tests/load/queue-load.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@axe-core/playwright": "4.14.0",
    "@sentry/node": "^11.8.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/multer": "^2.3.0",
    "axe-core": "4.14.0",
    "better-auth": "^1.7.10",
    "cloudinary": "2.11.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
